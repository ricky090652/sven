# ============================================================
# SVEN 專案 Dockerfile
# ============================================================
# 這個檔案定義了如何「打包」你的開發環境成一個 Docker image。
# 你可以想像 Dockerfile 就是一份「環境安裝 SOP」，
# Docker 會照著這份 SOP 一步步建出一個乾淨、獨立的環境。
# ============================================================

# ----------------------------------------------------------
# FROM：選擇「基底 image」
# ----------------------------------------------------------
# 就像裝電腦要先選作業系統一樣，這裡選擇一個已經裝好
# CUDA 11.7 + cuDNN + Ubuntu 22.04 的基底 image。
# 因為你的 torch==1.13.1+cu117 需要 CUDA 11.7。
FROM nvidia/cuda:11.7.1-cudnn8-devel-ubuntu22.04

# ----------------------------------------------------------
# 環境變數設定
# ----------------------------------------------------------
# DEBIAN_FRONTEND=noninteractive：讓 apt install 不要跳出互動式問答
# PYTHONUNBUFFERED=1：讓 Python 的 print 立即顯示（不會被 buffer 吃掉）
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# ----------------------------------------------------------
# 安裝系統套件
# ----------------------------------------------------------
# RUN：在 image 裡執行指令（就像你在終端機打指令一樣）
# 這裡安裝 Python 3.10 和一些基本工具
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-venv \
    python3-pip \
    git \
    vim \
    tmux \
    && rm -rf /var/lib/apt/lists/*

# 讓 python3 指向 python3.10
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# ----------------------------------------------------------
# WORKDIR：設定工作目錄
# ----------------------------------------------------------
# 之後所有指令都會在 /workspace 底下執行
# 這只是 container 裡面的路徑，不是你電腦上的
WORKDIR /workspace

# ----------------------------------------------------------
# 安裝 Python 套件
# ----------------------------------------------------------
# COPY：把你電腦上的檔案複製到 image 裡面
# 先複製 requirements 檔案，這樣如果套件沒變，
# Docker 會用 cache 加速，不用每次重新安裝
COPY requirements_freeze.txt .

# 安裝所有 Python 套件（跟你 .venv1 一模一樣的版本）
RUN pip3 install --no-cache-dir -r requirements_freeze.txt

# ----------------------------------------------------------
# 複製專案程式碼並安裝
# ----------------------------------------------------------
# 複製整個專案進 image
COPY . .

# 以 editable 模式安裝 sven 套件
RUN pip3 install -e .

# ----------------------------------------------------------
# CMD：container 啟動時預設執行的指令
# ----------------------------------------------------------
# 這裡設定啟動後直接進入 bash shell，讓你可以互動操作
CMD ["/bin/bash"]
