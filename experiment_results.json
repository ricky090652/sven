  "conclusions": [
    {
      "finding": "All prefix variants significantly improve security over the base model",
      "evidence": "Base model sec rate is 58.1%. All 4 prefix variants achieve 81.6%~86.0%, representing +23.5%~+27.9% absolute improvement in security.",
      "explanation": "Prefix tuning effectively steers the model toward generating secure code patterns, regardless of the specific loss configuration used."
    },
    {
      "finding": "All prefix variants cause some code quality degradation",
      "evidence": "Base model pass@1 is 6.6%. All prefix variants range from 5.3%~6.2%, representing -0.4%~-1.3% absolute loss.",
      "explanation": "The prefix introduces a security bias that slightly conflicts with general-purpose code generation. This is the inherent security-utility trade-off of prefix tuning."
    },
    {
      "finding": "Contrastive loss is essential in dual-prefix architecture for security but does not affect code quality",
      "evidence": "Removing contrastive loss (#2) caused security to drop 3.3% (84.9% to 81.6%) but pass@1 remained identical (5.7%). #2 even has higher pass@5 (9.3% vs 8.2%) and pass@10 (10.6% vs 9.3%).",
      "explanation": "Contrastive loss primarily drives sec/vul prefix differentiation. Without it, prefixes learn similar representations, weakening security. But it doesn't affect the base model's generation capability."
    },
    {
      "finding": "Unlikelihood loss maximizes security but causes the most code quality degradation",
      "evidence": "#3 has the highest sec rate (86.0%, +27.9% vs base) but the lowest pass@1 (5.3%, -1.3% vs base). Compared to #4: UL loss provides +1.2% sec rate but costs -0.9% pass@1.",
      "explanation": "UL loss aggressively suppresses vulnerable token probabilities, maximizing security improvement. However, this 'penalty-based' learning over-suppresses some normal code generation patterns."
    },
    {
      "finding": "Secure-only training (Single Prefix #4) achieves the best security-utility trade-off",
      "evidence": "#4 achieves 84.8% sec rate (+26.7% vs base) with only -0.4% pass@1 loss (6.2% vs base 6.6%). It is the closest to the base model in code quality while achieving nearly the same security as the original SVEN.",
      "explanation": "Pure positive guidance (learning from secure samples only) provides maximum security improvement per unit of code quality degradation. The efficiency ratio is: +26.7% security / -0.4% quality = 66.75 security-per-quality-point, the best among all variants."
    }
  ]
